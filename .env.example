# KORA FORGE, variáveis de ambiente reconhecidas. Nenhuma é obrigatória.
# Copie para .env.local e ajuste. Detalhes em INSTALACAO.md.
#
# Chave de API nunca entra aqui. Vai para o cofre (ADR-006).

# Porta da API local. O bind é sempre 127.0.0.1 e não é configurável.
FORGE_PORT=7337

# Pasta de dados do Forge: banco, chave de sessão, presets custom e logs.
FORGE_HOME=~/.kora-forge

# Raiz permitida para materializar projetos. Vazio de propósito: definir antes do primeiro projeto.
FORGE_WORKSPACE=

# Copiloto Claude, desligado por padrão (on | off).
FORGE_COPILOT=off

# Teto mensal do copiloto, em dólares.
FORGE_COPILOT_BUDGET_USD=5
