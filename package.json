{
  "name": "kora-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Bancada local para nascer projeto novo no padrão Kora.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "forge": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:server\" \"npm run dev\"",
    "forge:init": "node server/cli/init.js",
    "dev": "vite",
    "dev:server": "node server/index.js --dev",
    "start": "node server/index.js",
    "build": "vite build",
    "test": "vitest run",
    "db:migrate": "node server/cli/migrate.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "@tanstack/react-query": "5.102.8",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "jsdom": "30.0.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
