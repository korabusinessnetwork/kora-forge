    "white_label": true,
    "auth": true,
    "deploy": "vercel",
    "tem_ui": true
  },
  "arvore": [
    "fundacao-kora",
    "vite-react",
    "camada-de-servicos",
    "design-tokens",
    "supabase-schema",
    "config-base"
