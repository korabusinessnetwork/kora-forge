{
  "id": "criar-site",
  "nome": "Criar Site",
  "descricao": "Site institucional ou landing page. Sem auth, sem banco. Foco em design, performance e SEO.",
  "versao": 2,
  "categoria": "site",
  "icone": "globe",
  "etapas": ["identidade", "escopo", "design", "seguranca", "fundacao", "materializar"],
  "defaults": {
    "modelo_arquitetura": "A",
    "stack": ["react", "vite", "react-router"],
    "multi_tenant": false,
    "white_label": true,
    "auth": false,
    "deploy": "vercel",
    "tem_ui": true,
    "banco": false
  },
  "arvore": ["fundacao-kora", "vite-react", "design-tokens", "seo-base", "config-base"],
  "regras_extras": ["ux-tem-ui-exige-design-system", "seo-meta-obrigatorio"],
  "skills": ["fundacao-de-projeto", "business-fundamentos-iman-gadzhi"],
  "mcps": ["playwright", "chrome-devtools"],
  "requisitos": [{ "bin": "node", "min": "20" }, { "bin": "git" }, { "bin": "npm", "min": "11" }],
  "comandos": [
    { "id": "git-init", "cmd": "git", "args": ["init"], "obrigatorio": true },
    { "id": "install", "cmd": "npm", "args": ["install"], "obrigatorio": true, "timeout_ms": 600000 },
    { "id": "dev", "cmd": "npm", "args": ["run", "dev"], "longa_duracao": true, "obrigatorio": false }
  ],
  "definition_of_done": [
    "memory/identity.md com posicionamento e tom de voz",
    "meta tags e Open Graph preenchidos a partir da identidade",
    "tokens de design vindos do Studio ou do tema default",
    "nenhuma marca hardcodada fora dos tokens",
    "build passa e Lighthouse acima de 90 em performance"
  ]
}
